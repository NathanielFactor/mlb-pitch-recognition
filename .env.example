# Production Environment Variables for Vercel Deployment
# Copy these to your Vercel project settings

# Frontend Environment Variables (NEXT_PUBLIC_ prefix makes them available in browser)
NEXT_PUBLIC_API_URL=https://your-vercel-app.vercel.app

# Backend Environment Variables
MOCK_MODE=false
CORS_ORIGINS=["https://your-vercel-app.vercel.app","https://your-custom-domain.com"]
UPLOAD_DIR=/tmp/uploads
MAX_FILE_SIZE=104857600
MODEL_PATH=/tmp/models

# Supabase Configuration (Get from Supabase project)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-public-key
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=video-uploads

# Vercel-specific optimizations
PYTHONPATH=api
VERCEL=1