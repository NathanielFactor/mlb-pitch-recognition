{
  "version": 2,
  "builds": [
    {
      "src": "webapp/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "api/vercel_app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/vercel_app.py"
    },
    {
      "src": "/(.*)",
      "dest": "/webapp/$1"
    }
  ],
  "env": {
    "PYTHONPATH": "api"
  },
  "functions": {
    "api/vercel_app.py": {
      "runtime": "python3.11",
      "maxDuration": 30
    }
  },
  "outputDirectory": "webapp/.next",
  "framework": "nextjs"
}