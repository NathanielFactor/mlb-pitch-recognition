{
  "builds": [
    {
      "src": "webapp/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "api/test.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/test.py"
    },
    {
      "src": "/(.*)",
      "dest": "/webapp/$1"
    }
  ]
}
